{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug TestBattle.exe",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\TestBattle.exe",
            "args": [1],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\mingw64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            // "preLaunchTask": "build-debug"
        },
        {
            "name": "Debug Run.exe",
